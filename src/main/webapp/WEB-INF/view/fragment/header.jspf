<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>

<!DOCTYPE html>
<html lang="it">
	<head>
    	<meta charset="UTF-8">
    	<meta name="viewport" content="width=device-width, initial-scale=1.0">
    	<link rel="icon" type="image/png" href="${pageContext.servletContext.contextPath}/images/icons8-star-16.png">
    	<title>${titoloPagina != null ? titoloPagina : 'Home'} | SolidifyLab</title>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
		<link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/css/global.css">
		<link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/css/header.css">
		<link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/css/${cssPagina != null ? cssPagina : 'index.css'}">
		<link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/css/footer.css">
		<link rel="icon" type="image/png" href="${pageContext.servletContext.contextPath}/images/icons8-star-16.png?v=2">
	</head>
	
<body class="${not empty isHome ? 'snap-page' : ''}">

    <header class="main-header">
       
       <nav class="main-nav">
		    <ul>
		        <li class="dropdown">
		            <a href="${pageContext.request.contextPath}/Catalogo">Catalogo <i class="fa-solid fa-chevron-down"></i></a>
		            <div class="dropdown-menu full-menu">

		                <div class="dropdown-column">
		                    <h4><a href="${pageContext.request.contextPath}/Catalogo?tipo=3D">Modelli 3D</a></h4>
		                    <ul>
		                        <li><a href="${pageContext.request.contextPath}/Catalogo?tipo=3D&tag=ambienti">Ambienti</a></li>
		                        <li><a href="${pageContext.request.contextPath}/Catalogo?tipo=3D&tag=creature">Creature</a></li>
		                        <li><a href="${pageContext.request.contextPath}/Catalogo?tipo=3D&tag=personaggi">Personaggi</a></li>
		                        <li><a href="${pageContext.request.contextPath}/Catalogo?tipo=3D&tag=props">Props</a></li>
		                    </ul>
		                </div>

		                <div class="dropdown-column">
		                	<h4><a href="${pageContext.request.contextPath}/Catalogo?tipo=TEXTURES">Textures</a></h4>
		                    <ul>
		                        <li><a href="${pageContext.request.contextPath}/Catalogo?tipo=TEXTURES&tag=architettura">Architettura</a></li>
		                        <li><a href="${pageContext.request.contextPath}/Catalogo?tipo=TEXTURES&tag=metalli">Metalli</a></li>
		                        <li><a href="${pageContext.request.contextPath}/Catalogo?tipo=TEXTURES&tag=tessuti">Tessuti</a></li>
		                        <li><a href="${pageContext.request.contextPath}/Catalogo?tipo=TEXTURES&tag=organiche">Organiche</a></li>
		                    </ul>
		                </div>
		                
		            </div>
		        </li>
		        
		        <li>
		            <c:choose>
		                <c:when test="${not empty sessionScope.utenteLoggato and sessionScope.utenteLoggato.ruolo == 'ADMIN'}">
		                    <a href="${pageContext.request.contextPath}/GestioneCommissioni">Commissioni</a>
		                </c:when>
		                <c:otherwise>
		                    <a href="${pageContext.request.contextPath}/Commissioni">Commissioni</a>
		                </c:otherwise>
		            </c:choose>
		        </li>
		        
		        <li><a href="${pageContext.request.contextPath}/Stampe">Stampe 3D</a></li>
		    </ul>
		</nav>
		
		<div class="logo">
  			<a href="${pageContext.request.contextPath}/Home">
   			    <img src="${pageContext.request.contextPath}/images/logo-prova1.png" alt="Logo">
 			</a>
		</div>
        
       <div class="search-bar" style="position: relative;">
		    <form id="headerSearchForm" action="#" method="GET">
		        <input type="text" id="headerSearchInput" name="q" placeholder="Ricerca..." autocomplete="off">
		        
		        <button type="submit" class="search-btn">
		            <i class="fa-solid fa-magnifying-glass"></i>
		        </button>
		        <div id="headerSearchSuggestions" class="suggestions-box">
		        </div>
		    </form>
		</div>
        
      	<div class="user-icons">
      		<a href="${pageContext.request.contextPath}/Wishlist">
		    	<button type="button" class="icon-btn" title="Wishlist">
		        	<i class="fa-regular fa-heart"></i>
		    	</button>
		    </a>	
		    
		    <div class="dropdown profile-dropdown">
                <c:choose>
                    <c:when test="${not empty sessionScope.utenteLoggato and sessionScope.utenteLoggato.ruolo == 'ADMIN'}">
                        <a href="${pageContext.request.contextPath}/AdminDashboard">
                    </c:when>
                    <c:when test="${not empty sessionScope.utenteLoggato and sessionScope.utenteLoggato.ruolo != 'ADMIN'}">
                        <a href="${pageContext.request.contextPath}/UserDashboard">
                    </c:when>
                    <c:otherwise>
                        <a href="${pageContext.request.contextPath}/Login">
                    </c:otherwise>
                </c:choose>
		        	<button type="button" class="icon-btn" title="Profilo">
                        <i class="${not empty sessionScope.utenteLoggato ? 'fa-solid' : 'fa-regular'} fa-user"></i>
		        	</button>
				</a>
				
		        <ul class="dropdown-menu profile-menu">
                    <c:choose>
                        <c:when test="${not empty sessionScope.utenteLoggato}">
                            <c:if test="${sessionScope.utenteLoggato.ruolo == 'ADMIN'}">
                                <li><a href="${pageContext.request.contextPath}/AdminDashboard">Area Admin</a></li>
                            </c:if>
                            <c:if test="${sessionScope.utenteLoggato.ruolo != 'ADMIN'}">
                                <li><a href="${pageContext.request.contextPath}/UserDashboard">Il mio Profilo</a></li>
                            </c:if>
                            <li><a href="${pageContext.request.contextPath}/Logout">Log out</a></li>
                        </c:when>
                        <c:otherwise>
                            <li><a href="${pageContext.request.contextPath}/Login">Log in</a></li>
                            <li><a href="${pageContext.request.contextPath}/Signup">Sign up</a></li>
                        </c:otherwise>
                    </c:choose>
		        </ul>
		    </div>
		
			<a href="${pageContext.request.contextPath}/Carrello">
		    	<button type="button" class="icon-btn" title="Carrello">
		        	<i class="fa-solid fa-cart-shopping"></i>
		    	</button>
		    </a>	
		</div>
	</header>

	<script>
	document.addEventListener('DOMContentLoaded', function() {
	    const hSearchInput = document.getElementById('headerSearchInput');
	    const hSuggestionsBox = document.getElementById('headerSearchSuggestions');
	    const hSearchForm = document.getElementById('headerSearchForm');
	    
	    if (!hSearchInput) return; 

	    const hContesto = "generale";

	    hSearchInput.addEventListener('keyup', function() {
	        let query = this.value.trim();
	        if(query.length >= 2) {
	            const fetchUrl = '${pageContext.request.contextPath}/Search?q=' + encodeURIComponent(query) + '&contesto=' + hContesto;
	            
	            fetch(fetchUrl)
	                .then(response => response.json())
	                .then(data => {
	                    hSuggestionsBox.innerHTML = '';
	                    if(data.length > 0) {
	                        data.forEach(item => {
	                            let div = document.createElement('div');
	                            div.style.padding = '12px 15px';
	                            div.style.borderBottom = '1px solid rgba(15, 3, 38, 0.1)';
	                            div.style.cursor = 'pointer';
	                            div.style.transition = 'background 0.2s';
	                            div.style.color = '#0f0326';
	                            
	                            div.innerHTML = '<strong>' + item.nome + '</strong> - €' + item.prezzo.toFixed(2);
	                            div.onclick = function() {
	                                window.location.href = '${pageContext.request.contextPath}/Prodotto?id=' + item.id;
	                            };
	                            div.onmouseover = function() { this.style.backgroundColor = 'rgba(229, 99, 153, 0.15)'; };
	                            div.onmouseout = function() { this.style.backgroundColor = 'transparent'; };
	                            hSuggestionsBox.appendChild(div);
	                        });
	                        hSuggestionsBox.style.display = 'block';
	                    } else {
	                        hSuggestionsBox.innerHTML = '<div style="padding:12px 15px; color:#d1236d; font-style:italic; font-family: \'coolveticarg\', sans-serif;">Nessun risultato...</div>';
	                        hSuggestionsBox.style.display = 'block';
	                    }
	                })
	                .catch(error => console.error('Errore Fetch AJAX Header:', error));
	        } else {
	            hSuggestionsBox.style.display = 'none';
	        }
	    });

	    document.addEventListener('click', function(e) {
	        if(!hSearchForm.contains(e.target)) {
	            hSuggestionsBox.style.display = 'none';
	        }
	    });
	    
	    hSearchForm.addEventListener('submit', function(e) { e.preventDefault(); });
	});
	</script>