    <div id="cartOverlayBg" class="cart-overlay-bg" style="display: none;"></div>
    <aside id="cartOverlayPanel" class="cart-overlay-panel" style="right: -400px;">
        <header class="cart-overlay-header">
            <h3><i class="fa-solid fa-cart-shopping"></i> Il tuo Carrello</h3>
            
            <button type="button" id="closeCartBtn" class="btn-close-overlay" title="Chiudi">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </header>

        <div class="cart-overlay-body">
            <!-- Contenuto carrello dinamico -->
        </div>

        <footer class="cart-overlay-footer">
            <div class="cart-overlay-total">
                <span>Subtotale:</span>
                <strong>&euro; 0,00</strong>
            </div>
            
            <div class="cart-overlay-actions">
                <a href="${pageContext.request.contextPath}/carrello" class="btn-outline btn-full">VAI AL CARRELLO</a>
                <a href="${pageContext.request.contextPath}/carrello" class="btn-primary btn-full">CHECKOUT <i class="fa-solid fa-arrow-right"></i></a>
            </div>
        </footer>

    </aside>
